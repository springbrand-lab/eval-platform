{
  "name": "eval-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @eval-platform/eval-web --filter @eval-platform/eval-api run \"/^(dev|start:api|start:worker)$/\"",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "typegen": "pnpm -r --if-present typegen",
    "check:packages": "pnpm -r --if-present --filter './packages/**' check",
    "test:packages": "pnpm -r --if-present --filter './packages/**' test"
  }
}
