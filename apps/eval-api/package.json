{
  "name": "@eval-platform/eval-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "start:api": "tsx src/server.ts",
    "start:worker": "tsx src/run-worker-main.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@eval-platform/eval-contracts": "workspace:*",
    "@eval-platform/eval-dataset": "workspace:*",
    "@eval-platform/eval-metrics": "workspace:*",
    "@eval-platform/eval-runtime": "workspace:*",
    "@hono/node-server": "1.19.17",
    "@hono/zod-openapi": "1.5.1",
    "@springbrand/eval-harness": "0.1.0-alpha.0",
    "@springbrand/http": "0.1.0-alpha.4",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.33",
    "hono-pino": "0.10.3",
    "pg": "^8.23.0",
    "pg-boss": "12.28.0",
    "pino": "10.3.1",
    "stoker": "2.0.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
