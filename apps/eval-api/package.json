{
  "name": "@eval-platform/eval-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "start:independent-api": "tsx src/independent-evaluation-main.ts",
    "start:api": "tsx src/http-main.ts",
    "start:worker": "tsx src/run-worker-main.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@eval-platform/eval-contracts": "workspace:*",
    "@eval-platform/eval-dataset": "workspace:*",
    "@eval-platform/eval-metrics": "workspace:*",
    "@eval-platform/eval-runtime": "workspace:*",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
