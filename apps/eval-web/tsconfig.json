{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@springbrand/message-panel/cloud-os": [
        "./src/types/message-panel.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
